{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadGetObjectAvatars",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::s-pace/avatars/*"
    },
    {
      "Sid": "DenyPublicAccessCVs",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::s-pace/cvs/*"
    },
    {
      "Sid": "DenyPublicAccessCertificates",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::s-pace/certificates/*"
    }
  ]
}

